{
	"schemaVersion": 1,
	"id": "svenskacraft",
	"version": "${version}",
	"name": "SvenskaCraft",
	"description": "Learn Swedish while you play: hear and read the Swedish word for items you pick up, and survive a quiz every 10 minutes.",
	"authors": ["andreaskannaos-pixel"],
	"license": "MIT",
	"icon": "assets/svenskacraft/icon.png",
	"environment": "client",
	"entrypoints": { "client": ["svenskacraft.SvenskaCraft"] },
	"mixins": ["svenskacraft.mixins.json"],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~${minecraft}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
